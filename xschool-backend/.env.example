# Copie ce fichier en .env et adapte les valeurs. NE JAMAIS committer .env.

# --- Base de donnees PostgreSQL ---
# Format psycopg3 : postgresql+psycopg://user:root@host:port/xschool_db
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/xschool_db

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-moi-en-prod

# --- JWT ---
JWT_SECRET_KEY=change-moi-aussi-en-prod
# Duree de validite du token d'acces (minutes)
JWT_ACCESS_MINUTES=120

# --- CORS ---
# Origines autorisees du front (separees par des virgules), * pour tout en dev
CORS_ORIGINS=*
