# Copie ce fichier en .env et adapte les valeurs. NE JAMAIS committer .env.

# --- Base de donnees PostgreSQL ---
# Format psycopg3 : postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://xschool:xschool@localhost:5432/xschool

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-moi-en-prod

# --- JWT ---
JWT_SECRET_KEY=change-moi-aussi-en-prod
# Duree de validite du token d'acces (minutes)
JWT_ACCESS_MINUTES=120

# --- CORS ---
# Origines autorisees du front (separees par des virgules), * pour tout en dev
CORS_ORIGINS=*

# --- Rate limiting (Flask-Limiter) ---
# Active/desactive la limitation (true par defaut).
RATELIMIT_ENABLED=true
# Backend de comptage. 'memory://' = en memoire (OK en dev / mono-process).
# En production multi-worker (gunicorn), le compteur memoire est PAR worker :
# utilise un stockage partage, ex. redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# --- Passerelle de messagerie (WhatsApp / SMS) ---
# Fournisseur actif : none (ou log) = simulation, aucun appel reseau ;
#                     meta  = WhatsApp Cloud API (Meta / Facebook Graph) ;
#                     twilio = Twilio (WhatsApp et/ou SMS) ;
#                     generic = ton propre webhook HTTP JSON.
MESSAGING_PROVIDER=none
# Indicatif pays applique aux numeros locaux a 8 chiffres (Togo = 228).
DEFAULT_COUNTRY_CODE=228

# -- WhatsApp Cloud API (MESSAGING_PROVIDER=meta) --
# Jeton d'acces permanent et identifiant du numero expediteur (Phone Number ID).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# URL de base de la Graph API (change seulement si tu epingles une version).
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# -- Twilio (MESSAGING_PROVIDER=twilio) --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Expediteur WhatsApp (format whatsapp:+14155238886) et/ou SMS (format +14155238886).
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# -- Webhook generique (MESSAGING_PROVIDER=generic) --
# Le serveur POST un JSON {channel, to, text} sur cette URL.
GENERIC_WEBHOOK_URL=
# Envoye en en-tete Authorization: Bearer <cle> si renseigne.
GENERIC_API_KEY=

# ============================================================================
# Notifications email (alertes de securite : pic d'echecs de connexion)
# ============================================================================
# Tant que SMTP_HOST est vide, l'envoi tourne en SIMULATION (aucun reseau).
SMTP_HOST=
# Port SMTP. Defaut : 587 (STARTTLS) ou 465 (SSL) selon SMTP_SECURITY.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Adresse expediteur (defaut = SMTP_USER).
SMTP_FROM=
# Transport chiffre : starttls (defaut) | ssl | none.
SMTP_SECURITY=starttls
# Delai reseau en secondes.
SMTP_TIMEOUT=12
# Destinataires des alertes de securite (separes par des virgules).
# Vide = aucune notification email envoyee.
SECURITY_ALERT_EMAILS=

# URL publique du front (utilisee dans les emails de rappel pour le bouton
# "Ouvrir mes exercices"). Ex: https://xschool-front.onrender.com
# Vide = l'email reste valide mais sans lien clquable.
APP_PUBLIC_URL=

# Schema d'URL de l'appli mobile, utilise pour les deep-links des
# notifications push (ex: xschool://exercise/42). Defaut: xschool
APP_MOBILE_SCHEME=xschool

# --- Notifications push mobiles (Firebase Cloud Messaging) ---
# Tant que FCM_SERVER_KEY est vide, le push tourne en SIMULATION (aucun envoi
# reseau, aucune erreur) : la cloche et l'email fonctionnent normalement.
# PUSH_PROVIDER : 'fcm' (defaut) ou 'none' pour desactiver explicitement.
PUSH_PROVIDER=fcm
# Cle serveur FCM (Console Firebase > Parametres > Cloud Messaging). SECRET.
FCM_SERVER_KEY=
# Optionnels : surcharge de l'URL FCM et delai reseau (secondes).
FCM_ENDPOINT=
PUSH_TIMEOUT=10
